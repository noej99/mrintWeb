---
/**
 * 404 (docs/requirements.md §11, docs/sitemap.md §9)
 * - 기존 사이트의 개발용 문구('index page 입니다.')를 노출하지 않는다.
 * - 제공: 404 표시, '페이지를 찾을 수 없습니다.', 홈으로 이동, 검색
 * - 정적 호스팅의 fallback(404.html)으로 표시된다. robots: noindex, follow
 * TODO(Phase 10/11): title 정책, 기존 URL redirect는 별도 Phase에서 처리
 */
import SearchForm from '@/components/search/SearchForm.astro';
import Button from '@/components/ui/Button.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Section from '@/components/ui/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE_NAME } from '@/lib/site';

const pageTitle = '페이지를 찾을 수 없습니다.';
---

<BaseLayout title={`404 | ${SITE_NAME}`} noindex>
  <PageHeader eyebrow="404" title={pageTitle} />

  <Section spacing="compact" aria-label="페이지 이동">
    <div class="not-found">
      <Button href="/" arrow>홈으로 이동</Button>
      <SearchForm id="not-found-query" label="사이트 검색" />
    </div>
  </Section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: start;
    gap: clamp(40px, 5vw, 64px);
  }

  .not-found > :global(form) {
    width: 100%;
  }
</style>
