---
/**
 * 전체 사이트 검색 (/search?q={query}) — 기존 우측 상단 Global Search(/?s=) 대체 (docs/requirements.md §10, D-23)
 * - 검색 대상: Company / Team / News / Projects / Business (Partner는 Project·Business 문서의 필드로만)
 * - 색인: build 시 /search-index.json (src/pages/search-index.json.ts), 검색: src/scripts/search.ts
 * - JS 미동작 시: 검색 form과 안내 문구만 표시 (결과는 JS 필요). 안내 문구는 html:not(.js)에서만 보인다. (BaseHead가 .js 추가)
 * - robots: noindex, follow / canonical 없음 (BaseHead noindex). title·sitemap 정책은 Phase 10에서 확정
 * - Project 목록 필터(/projects)와는 별개 기능이다.
 */
import SearchForm from '@/components/search/SearchForm.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Section from '@/components/ui/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE_NAME } from '@/lib/site';
import { withBase } from '@/lib/url';

const pageTitle = 'Search';
---

<BaseLayout title={`${pageTitle} | ${SITE_NAME}`} noindex>
  <PageHeader title={pageTitle} breadcrumbs={[{ label: 'Home', href: '/' }, { label: pageTitle }]} />

  <Section spacing="compact" aria-label="사이트 검색">
    <div class="search" data-search data-index-url={withBase('/search-index.json')}>
      <SearchForm id="search-query" />

      <p class="search__notice search__nojs" data-search-nojs>JavaScript가 활성화되어 있어야 검색 기능을 사용할 수 있습니다.</p>

      <p class="search__status mono" role="status" data-search-status></p>

      <p class="search__guide" data-search-guide hidden>
        검색어를 입력해 주세요. Company, Team, News, Projects, Business Line 콘텐츠를 검색합니다.
      </p>

      <div data-search-empty hidden>
        <EmptyState title="검색 결과가 없습니다." description="다른 검색어로 다시 검색해 주세요." />
      </div>

      <p class="search__notice" data-search-error hidden>검색 데이터를 불러오지 못했습니다. 잠시 후 다시 시도해 주세요.</p>

      <div class="search__results" data-search-results></div>
    </div>
  </Section>
</BaseLayout>

<script>
  import '@/scripts/search';
</script>

<style>
  .search {
    display: grid;
    gap: 32px;
  }

  :global(html.js) .search__nojs {
    display: none;
  }

  .search__status:empty {
    display: none;
  }

  .search__status {
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .search__guide,
  .search__notice {
    max-width: 880px;
    color: var(--text-muted);
  }

  .search__notice {
    padding: 16px 20px;
    border-left: 3px solid var(--accent);
    background: var(--paper);
    color: var(--text);
  }

  .search__results {
    display: grid;
    gap: clamp(40px, 5vw, 64px);
  }

  .search__results:empty {
    display: none;
  }

  /* 결과는 src/scripts/search.ts가 DOM API로 생성한다 → :global (범위는 .search 안으로 제한) */
  .search :global(.search-group__title) {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 14px;
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-mono);
  }

  .search :global(.search-group__label) {
    font-family: var(--font-mono);
  }

  .search :global(.search-group__count) {
    color: var(--text-muted);
    font-weight: 400;
  }

  .search :global(.search-list) {
    border-top: 1px solid var(--border-strong);
  }

  .search :global(.search-list > li) {
    border-bottom: 1px solid var(--border);
  }

  .search :global(.search-row) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 24px;
    gap: 24px;
    align-items: baseline;
    padding: 22px 0;
  }

  .search :global(.search-row:focus-visible) {
    outline-offset: -3px;
  }

  .search :global(.search-row__title) {
    font-size: clamp(17px, 1.35vw, 20px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .search :global(.search-row:hover .search-row__title) {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .search :global(.search-row__meta) {
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .search :global(.search-row__arrow) {
    grid-column: 3;
    justify-self: end;
    align-self: center;
    width: 10px;
    height: 10px;
    border-top: 1.5px solid currentColor;
    border-right: 1.5px solid currentColor;
    transform: rotate(45deg);
    opacity: 0.35;
  }

  .search :global(.search-row:is(:hover, :focus-visible) .search-row__arrow) {
    opacity: 1;
  }

  @media (max-width: 767px) {
    .search :global(.search-row) {
      grid-template-columns: minmax(0, 1fr) 16px;
      gap: 6px 16px;
      padding: 18px 0;
    }

    .search :global(.search-row__title) {
      grid-column: 1;
      font-size: var(--fs-base);
    }

    .search :global(.search-row__meta) {
      grid-column: 1;
      grid-row: 2;
      white-space: normal;
    }

    .search :global(.search-row__arrow) {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
