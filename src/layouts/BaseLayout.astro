---
import '@/styles/tokens.css';
import '@/styles/base.css';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import SkipLink from '@/components/layout/SkipLink.astro';
import BaseHead, { type Props as HeadProps } from '@/components/seo/BaseHead.astro';

type Props = HeadProps & {
  headerVariant?: 'solid' | 'overlay';
};

const { headerVariant = 'solid', ...head } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead {...head} />
    <slot name="head" />
  </head>
  <body class="tone-white">
    <SkipLink />
    <Header variant={headerVariant} currentPath={currentPath} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
