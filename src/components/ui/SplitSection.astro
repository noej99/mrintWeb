---
/**
 * SplitSection — 좌측 섹션 제목(약 1/3) + 우측 콘텐츠(약 2/3). 모바일/태블릿은 1열.
 * 기존 사이트 상세 페이지 레이아웃 기준 (예: /mirae/ INTRODUCTION, CONTACT US)
 */
import Section from './Section.astro';

interface Props {
  title: string;
  /** heading id (aria-labelledby) */
  id: string;
  tone?: 'white' | 'paper' | 'ink';
  spacing?: 'default' | 'compact' | 'none';
}

const { title, id, tone = 'white', spacing = 'compact' } = Astro.props;
---

<Section tone={tone} spacing={spacing} class="split-section" aria-labelledby={id}>
  <div class="split">
    <h2 id={id} class="split__title">{title}</h2>
    <div class="split__body">
      <slot />
    </div>
  </div>
</Section>

<style>
  .split-section + :global(.split-section) {
    border-top: 1px solid var(--border);
  }

  .split {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 32px var(--gutter);
  }

  .split__title {
    grid-column: 1 / 5;
    font-size: clamp(24px, 2.2vw, 34px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }

  .split__body {
    grid-column: 5 / -1;
    min-width: 0;
  }

  @media (min-width: 1101px) {
    .split__title {
      position: sticky;
      top: calc(var(--header-h) + 32px);
      align-self: start;
    }
  }

  @media (max-width: 1100px) {
    .split__title,
    .split__body {
      grid-column: 1 / -1;
    }
  }
</style>
