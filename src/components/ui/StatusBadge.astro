---
/**
 * StatusBadge — 상태/구분 표시. 텍스트를 항상 표시해 색상만으로 상태를 전달하지 않는다. (CLAUDE.md §9)
 * label은 데이터(taxonomy label 등)의 원문을 그대로 전달한다.
 */
interface Props {
  label: string;
  tone?: 'neutral' | 'outline' | 'strong' | 'accent';
}

const { label, tone = 'neutral' } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`]}>{label}</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 3px 10px;
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-mono);
    line-height: 1.4;
    color: var(--text-muted);
    white-space: nowrap;
    transition:
      color 0.4s,
      border-color 0.4s;
  }

  .badge--outline {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .badge--strong {
    background: var(--text);
    border-color: var(--text);
    color: var(--surface);
  }

  .badge--accent {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--ink);
  }
</style>
