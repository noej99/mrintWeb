---
/**
 * ResponsiveImage — AVIF/WebP + srcset/sizes + width/height (CLAUDE.md §11)
 * - alt 필수. 장식용은 alt="" (CLAUDE.md §9)
 * - priority: Hero/LCP 이미지 → lazy 해제, fetchpriority=high
 * - 원본보다 큰 width는 생성하지 않는다.
 * src는 import한 로컬 이미지(ImageMetadata). 데이터의 image.src 연결은 콘텐츠 이관 Phase에서 정의한다.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  priority?: boolean;
  class?: string;
}

const DEFAULT_WIDTHS = [480, 768, 1024, 1440, 1920];

const { src, alt, sizes = '100vw', widths = DEFAULT_WIDTHS, priority = false, class: className } = Astro.props;
const usableWidths = [...new Set([...widths.filter((width) => width < src.width), src.width])].sort((a, b) => a - b);
---

<Picture
  src={src}
  alt={alt}
  widths={usableWidths}
  sizes={sizes}
  formats={['avif', 'webp']}
  loading={priority ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={priority ? 'high' : undefined}
  class={className}
/>
