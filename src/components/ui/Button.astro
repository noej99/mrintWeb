---
/**
 * Button — href가 있으면 <a>, 없으면 <button>
 * variant
 * - primary: accent 배경
 * - secondary: 현재 tone의 텍스트 색 테두리
 * - ghost: 약한 테두리 (어두운 배경용)
 * - solid: 현재 tone의 텍스트 색 배경 (반전)
 */
import type { HTMLAttributes } from 'astro/types';
import { withBase } from '@/lib/url';

type Variant = 'primary' | 'secondary' | 'ghost' | 'solid';
type Size = 'md' | 'lg';

type CommonProps = {
  variant?: Variant;
  size?: Size;
  /** 장식용 화살표 표시 */
  arrow?: boolean;
  class?: string;
};

type Props =
  | (CommonProps & Omit<HTMLAttributes<'a'>, 'class'> & { href: string })
  | (CommonProps & Omit<HTMLAttributes<'button'>, 'class'> & { href?: undefined });

const { variant = 'primary', size = 'md', arrow = false, class: className, ...attrs } = Astro.props;
const classes = ['button', `button--${variant}`, `button--${size}`, className];
---

{
  'href' in attrs && attrs.href !== undefined ? (
    <a class:list={classes} {...(attrs as HTMLAttributes<'a'>)} href={withBase(attrs.href)}>
      <slot />
      {arrow && <span class="button__arrow" aria-hidden="true" />}
    </a>
  ) : (
    <button class:list={classes} type="button" {...(attrs as HTMLAttributes<'button'>)}>
      <slot />
      {arrow && <span class="button__arrow" aria-hidden="true" />}
    </button>
  )
}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    height: 56px;
    padding: 0 28px;
    border: 1px solid currentColor;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    transition:
      background 0.35s var(--ease),
      color 0.35s,
      border-color 0.35s;
  }

  .button--lg {
    height: 72px;
    padding: 0 36px;
    font-size: var(--fs-md);
  }

  .button--primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--ink);
  }

  .button--primary:hover {
    background: var(--text);
    border-color: var(--text);
    color: var(--surface);
  }

  .button--secondary {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .button--secondary:hover,
  .button--solid {
    background: var(--text);
    border-color: var(--text);
    color: var(--surface);
  }

  .button--solid:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--ink);
  }

  .button--ghost {
    border-color: color-mix(in srgb, currentColor 35%, transparent);
    color: var(--text);
  }

  .button--ghost:hover {
    border-color: currentColor;
    background: color-mix(in srgb, currentColor 6%, transparent);
  }

  .button:disabled,
  .button[aria-disabled='true'] {
    opacity: 0.45;
    pointer-events: none;
  }

  .button__arrow {
    position: relative;
    flex: none;
    width: 18px;
    height: 1px;
    background: currentColor;
    transition: width 0.35s var(--ease);
  }

  .button__arrow::after {
    content: '';
    position: absolute;
    right: 0;
    top: -3px;
    width: 7px;
    height: 7px;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
    transform: rotate(45deg);
  }

  .button:hover .button__arrow {
    width: 28px;
  }

  @media (max-width: 767px) {
    .button {
      height: 52px;
      padding: 0 22px;
    }

    .button--lg {
      height: 64px;
    }
  }
</style>
