---
/**
 * PageHeader — 페이지당 하나의 h1 (docs/seo.md §9)
 * 문구(title/eyebrow/description)는 페이지에서 원문으로 전달한다.
 */
import Breadcrumb, { type BreadcrumbItem } from './Breadcrumb.astro';
import Container from './Container.astro';

interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  breadcrumbs?: readonly BreadcrumbItem[];
  tone?: 'white' | 'paper' | 'ink';
  /** compact: 긴 제목(News 상세 등)용 작은 h1 */
  size?: 'default' | 'compact';
}

const { title, eyebrow, description, breadcrumbs = [], tone = 'white', size = 'default' } = Astro.props;
---

<header class:list={['page-header', `page-header--${size}`, `tone-${tone}`]}>
  <Container>
    {breadcrumbs.length > 0 && <Breadcrumb items={breadcrumbs} />}
    <div class="page-header__body">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="page-header__title">{title}</h1>
      {description && <p class="page-header__description">{description}</p>}
      <slot />
    </div>
  </Container>
</header>

<style>
  .page-header {
    padding-block: clamp(40px, 6vw, 72px) clamp(56px, 8vw, 120px);
    border-bottom: 1px solid var(--border);
  }

  .page-header__body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0 var(--gutter);
    margin-top: clamp(40px, 6vw, 80px);
  }

  .page-header__body > :global(*) {
    grid-column: 1 / -1;
  }

  .page-header__title {
    margin-top: 24px;
    font-size: var(--fs-h1);
    font-weight: 700;
    line-height: 1.14;
    letter-spacing: -0.045em;
  }

  .page-header--compact .page-header__title {
    font-size: clamp(28px, 3.4vw, 52px);
    line-height: 1.3;
    letter-spacing: -0.035em;
  }

  .page-header__description {
    margin-top: 32px;
    max-width: 60ch;
    font-size: var(--fs-lead);
    line-height: 1.7;
    letter-spacing: -0.025em;
    color: var(--text-muted);
  }

  @media (min-width: 1101px) {
    .page-header__body > .page-header__title {
      grid-column: 1 / 10;
    }
  }
</style>
