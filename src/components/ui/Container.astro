---
import type { HTMLAttributes, HTMLTag } from 'astro/types';

type Props = HTMLAttributes<'div'> & {
  as?: HTMLTag;
  /** default: 1480px, narrow: 본문 읽기 폭 */
  size?: 'default' | 'narrow';
};

const { as: Tag = 'div', size = 'default', class: className, ...attrs } = Astro.props;
---

<Tag class:list={['container', `container--${size}`, className]} {...attrs}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--pad);
  }

  .container--narrow {
    max-width: calc(880px + var(--pad) * 2);
  }
</style>
