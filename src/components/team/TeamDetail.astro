---
/**
 * TeamDetail — 기존 Markdown 원문을 구조화된 HTML로 표시
 * - team: Team Introduction / Main Functions / Key Capabilities (기존 원문 제목)
 * - person(CEO): 약력 블록 (기존 원문 블록 제목)
 * - 대표 이미지는 첫 섹션 본문 상단 (확인 전 placeholder)
 * - Related Projects: 항목이 있을 때만. Team 원문 제목/연도를 표시하고 Project 상세로 연결
 */
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import SplitSection from '@/components/ui/SplitSection.astro';
import type { TeamEntry } from '@/lib/content';
import RelatedProjectList from './RelatedProjectList.astro';

interface Props {
  member: TeamEntry;
}

const { member } = Astro.props;
const { data } = member;
const ratio = data.image?.width && data.image.height ? data.image.width / data.image.height : 2 / 3;

// Related Projects: 기존 Team 원문(제목·연도) + 신규 Project 상세 링크 (relatedProjects와 같은 순서)
const relatedItems = data.relatedProjectsLegacy.map((project, index) => {
  const slug = data.relatedProjects?.[index];
  return { title: project.title, year: project.year, href: slug ? `/projects/${slug}` : undefined };
});

type Block =
  | { id: string; title: string; kind: 'paragraphs'; items: string[]; lang?: undefined }
  | { id: string; title: string; kind: 'list'; items: string[]; lang?: 'ko' | 'en' };

const blocks: Block[] = [
  ...(data.introduction?.length
    ? [{ id: 'team-introduction', title: 'Team Introduction', kind: 'paragraphs' as const, items: data.introduction }]
    : []),
  ...(data.functions?.length
    ? [{ id: 'main-functions', title: 'Main Functions', kind: 'list' as const, items: data.functions }]
    : []),
  ...(data.capabilities?.length
    ? [{ id: 'key-capabilities', title: 'Key Capabilities', kind: 'list' as const, items: data.capabilities }]
    : []),
  ...(data.biography ?? []).map((block, index) => ({
    id: `biography-${index + 1}`,
    title: block.title,
    kind: 'list' as const,
    items: block.items,
    lang: block.lang,
  })),
];
---

{
  blocks.map((block, index) => (
    <SplitSection title={block.title} id={block.id}>
      {index === 0 && data.image && (
        <figure class="team-detail__media media-mono" style={`--ratio: ${ratio}`}>
          {/* TODO: 이미지 원본/라이선스 확인 후 ResponsiveImage로 교체 (D-13) */}
          <ImagePlaceholder ratio={ratio} tone="light" />
        </figure>
      )}
      {block.kind === 'paragraphs' ? (
        <div class="team-detail__text">
          {block.items.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      ) : (
        <ul class="team-detail__list" role="list" lang={block.lang}>
          {block.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )}
    </SplitSection>
  ))
}

{
  data.relatedProjectsLegacy.length > 0 && (
    <SplitSection title="Related Projects" id="related-projects" tone="paper">
      <RelatedProjectList items={relatedItems} />
    </SplitSection>
  )
}

<style>
  .team-detail__media {
    width: 100%;
    max-width: calc(520px * var(--ratio));
    margin: 0 0 clamp(32px, 4vw, 56px);
  }

  .team-detail__text {
    display: grid;
    gap: 1.2em;
    max-width: 64ch;
    font-size: var(--fs-md);
    line-height: 1.8;
    letter-spacing: -0.02em;
  }

  .team-detail__list {
    border-top: 1px solid var(--border-strong);
  }

  .team-detail__list li {
    position: relative;
    padding: 16px 0 16px 28px;
    border-bottom: 1px solid var(--border);
    font-size: var(--fs-md);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.6;
  }

  .team-detail__list li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: calc(16px + 0.8em - 3px);
    width: 6px;
    height: 6px;
    background: var(--accent);
  }

  @media (max-width: 767px) {
    .team-detail__list li {
      font-size: var(--fs-base);
      padding-block: 14px;
    }

    .team-detail__list li::before {
      top: calc(14px + 0.8em - 3px);
    }
  }
</style>
