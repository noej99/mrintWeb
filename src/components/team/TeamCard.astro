---
/**
 * TeamCard — Card 재사용. 이미지(image.src 없으면 placeholder) + 한국어/영어 이름 + 역할
 * 이미지는 원본 비율(2:3)로 표시한다. (Card 기본 16:10 crop 미적용)
 * 카드 전체 링크 1개 (제목 = 한국어 이름)
 */
import Card from '@/components/ui/Card.astro';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import ResponsiveImage from '@/components/ui/ResponsiveImage.astro';
import type { TeamEntry } from '@/lib/content';
import { resolveOptionalImage } from '@/lib/images';

interface Props {
  member: TeamEntry;
  headingLevel?: 2 | 3;
}

const { member, headingLevel = 2 } = Astro.props;
const { data } = member;
const ratio = data.image?.width && data.image.height ? data.image.width / data.image.height : 2 / 3;
const role = [data.titleKo, data.titleEn].filter(Boolean);
const photo = resolveOptionalImage(data.image);
---

<Card title={data.nameKo} href={`/team/${data.slug}`} headingLevel={headingLevel} class="team-card">
  <div slot="media" class="team-card__media media-mono" style={`--media-ratio: ${ratio}`}>
    {
      photo ? (
        <ResponsiveImage
          src={photo}
          alt={data.image?.alt ?? ''}
          sizes="(max-width: 1100px) 50vw, 25vw"
          widths={[360, 540, 720, 1080]}
        />
      ) : (
        <ImagePlaceholder ratio={ratio} tone="light" />
      )
    }
  </div>
  <p class="team-card__en" lang="en">{data.nameEn}</p>
  {
    role.length > 0 && (
      <p class="team-card__role mono">
        {data.titleKo}
        {data.titleEn && <span lang="en">{data.titleEn}</span>}
      </p>
    )
  }
</Card>

<style>
  /* Card의 16:10 crop 대신 원본 비율 유지 (명시 비율 → 이미지 로드 전 공간 확보, CLS 방지) */
  .team-card__media :global(picture > img) {
    aspect-ratio: var(--media-ratio);
    object-fit: cover;
  }

  .team-card__en {
    color: var(--text);
    font-weight: 500;
  }

  .team-card__role {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin-top: 12px;
    color: var(--text-muted);
  }

  .team-card__role span::before {
    content: '/';
    margin-right: 10px;
  }

  /* 390px 2열: 한글 팀명이 글자 단위로 끊기지 않도록
     (Card 루트에는 TeamCard scope 속성이 붙지 않으므로 클래스 기준 global 선택자 사용) */
  @media (max-width: 767px) {
    :global(.team-card.card .card__body) {
      padding: 20px 16px 22px;
    }

    :global(.team-card.card .card__title) {
      font-size: 18px;
      letter-spacing: -0.03em;
    }

    .team-card__en {
      font-size: 14px;
      line-height: 1.5;
    }
  }
</style>
