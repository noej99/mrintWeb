---
/**
 * BusinessDetail — 기존 contents 블록을 원문 순서대로 표시
 * ├─ 섹션: title 블록(기존 h3) → h2, 이어지는 description/image/tabs 블록
 * └─ Main Clients: clients(ACF partners) 순서, 이름 텍스트
 * Related Projects는 원본 관계 데이터가 없으므로 표시하지 않는다. (BL-15)
 */
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import SplitSection from '@/components/ui/SplitSection.astro';
import { groupBusinessSections, imageRatio } from '@/lib/business';
import type { BusinessEntry, PartnerEntry } from '@/lib/content';
import BusinessText from './BusinessText.astro';
import MainClients from './MainClients.astro';
import ServiceFeatures from './ServiceFeatures.astro';

interface Props {
  line: BusinessEntry;
  clients: readonly PartnerEntry[];
}

const { line, clients } = Astro.props;
const sections = groupBusinessSections(line.data.contents);
// 첫 title 블록 이전의 블록(현재 데이터에는 없음)은 페이지 제목을 섹션 제목으로 사용한다.
const sectionTitle = (title: string | undefined) => title ?? line.data.title;
---

{
  sections.map((section) => (
    <SplitSection title={sectionTitle(section.title)} id={section.id}>
      <div class="business-section" data-business-section>
        {section.blocks.map((block, index) =>
          block.type === 'description' ? (
            <BusinessText text={block.description} />
          ) : block.type === 'image' ? (
            <figure class="business-section__media">
              {/* TODO: 이미지 원본/라이선스/AI 생성 여부 확인 후 ResponsiveImage로 교체 (D-13) */}
              <ImagePlaceholder ratio={imageRatio(block.image, 16 / 9)} tone="light" />
            </figure>
          ) : (
            <ServiceFeatures tabs={block.tabs} id={`${section.id}-features-${index + 1}`} labelledby={section.id} />
          ),
        )}
      </div>
    </SplitSection>
  ))
}

{
  clients.length > 0 && (
    <SplitSection title="Main Clients" id="main-clients" tone="paper">
      <MainClients clients={clients} />
    </SplitSection>
  )
}

<style>
  .business-section {
    display: grid;
    gap: clamp(32px, 4vw, 56px);
    min-width: 0;
  }

  .business-section__media {
    margin: 0;
    max-width: 880px;
  }
</style>
