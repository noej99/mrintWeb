---
/**
 * Footer
 * 연락처/사명은 src/data/company 데이터가 있을 때만 표시한다. (임의 정보 생성 금지)
 * TODO: CLIENT CONFIRMATION REQUIRED — 개인정보처리방침/법적 고지 링크 (docs/decisions.md D-15)
 */
import Container from '@/components/ui/Container.astro';
import { toMailtoHref, toTelHref } from '@/lib/contact';
import { getCompany } from '@/lib/content';
import { NAVIGATION } from '@/data/navigation';
import Logo from './Logo.astro';
import LogoMark from './LogoMark.astro';

const company = await getCompany();
const year = new Date().getFullYear();
---

<footer class="site-footer tone-ink">
  <Container>
    <div class="site-footer__top">
      <Logo />
      <nav class="site-footer__nav" aria-label="바닥글 메뉴">
        {
          NAVIGATION.map((item) =>
            item.type === 'group' ? (
              <div class="site-footer__group">
                <h2 class="site-footer__group-label mono">{item.label}</h2>
                <ul role="list">
                  {item.children.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <div class="site-footer__group site-footer__group--solo">
                <a href={item.href}>{item.label}</a>
              </div>
            ),
          )
        }
      </nav>
    </div>

    {
      company && (
        <address class="site-footer__contact">
          <dl>
            <div>
              <dt class="mono">주소</dt>
              <dd>{company.data.address.ko}</dd>
            </div>
            <div>
              <dt class="mono">전화</dt>
              <dd>
                <a href={toTelHref(company.data.tel)}>{company.data.tel}</a>
              </dd>
            </div>
            <div>
              <dt class="mono">팩스</dt>
              <dd>{company.data.fax}</dd>
            </div>
            <div>
              <dt class="mono">이메일</dt>
              <dd>
                <a href={toMailtoHref(company.data.email)}>{company.data.email}</a>
              </dd>
            </div>
          </dl>
        </address>
      )
    }

    <div class="site-footer__wordmark" aria-hidden="true">
      <LogoMark />
    </div>

    <div class="site-footer__bottom mono">
      {company && <p>© {year} {company.data.name.ko}</p>}
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    padding-block: 72px 36px;
    overflow: hidden;
  }

  .site-footer__top {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }

  .site-footer__nav {
    display: flex;
    gap: clamp(32px, 5vw, 80px);
    flex-wrap: wrap;
  }

  .site-footer__group-label {
    color: var(--text-muted);
    font-weight: 500;
    margin-bottom: 12px;
  }

  .site-footer__group a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-size: 15px;
    color: var(--text);
    transition: color 0.3s;
  }

  .site-footer__group a:hover {
    color: var(--accent);
  }

  .site-footer__group--solo a {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-mono);
  }

  .site-footer__contact {
    margin-top: 56px;
    font-style: normal;
  }

  .site-footer__contact dl {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--border);
  }

  /* 열 구분선: 각 행의 첫 칸은 좌측 여백/선 없음 (breakpoint별 :nth-child로 지정) */
  .site-footer__contact dl > div {
    padding: 20px 24px 0;
    border-left: 1px solid var(--border);
  }

  .site-footer__contact dl > div:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .site-footer__contact dt {
    color: var(--text-muted);
  }

  .site-footer__contact dd {
    margin-top: 8px;
    font-size: 15px;
  }

  .site-footer__wordmark {
    margin: 80px 0 40px;
    color: var(--ink-3);
  }

  .site-footer__wordmark :global(svg) {
    width: 100%;
    height: auto;
  }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    min-height: 1px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
  }

  @media (max-width: 1100px) {
    .site-footer__contact dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer__contact dl > div:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .site-footer__contact dl > div:nth-child(n + 3) {
      padding-top: 24px;
    }
  }

  @media (max-width: 767px) {
    .site-footer__contact dl {
      grid-template-columns: minmax(0, 1fr);
    }

    .site-footer__contact dl > div:nth-child(n) {
      padding: 16px 0;
      border-left: 0;
    }

    .site-footer__contact dl > div:nth-child(n + 2) {
      border-top: 1px solid var(--border);
    }
  }
</style>
