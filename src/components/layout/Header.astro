---
/**
 * Header
 * - solid: 기본 (하위 페이지). sticky, 밝은 배경
 * - overlay: Home hero 위에 투명하게 표시, 스크롤 후 solid로 전환 (src/scripts/header.ts)
 */
import Container from '@/components/ui/Container.astro';
import DesktopNavigation from './DesktopNavigation.astro';
import Logo from './Logo.astro';
import MobileMenu from './MobileMenu.astro';

interface Props {
  variant?: 'solid' | 'overlay';
  currentPath: string;
}

const { variant = 'solid', currentPath } = Astro.props;
---

<header class="site-header" data-header data-variant={variant}>
  <Container class="site-header__inner">
    <Logo />
    <DesktopNavigation currentPath={currentPath} />
    <button
      type="button"
      class="menu-toggle"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-mobile-menu-open
    >
      <span class="visually-hidden">전체 메뉴 열기</span>
      <span class="menu-toggle__bar" aria-hidden="true"></span>
      <span class="menu-toggle__bar" aria-hidden="true"></span>
    </button>
  </Container>
</header>
<MobileMenu currentPath={currentPath} />

<script>
  import '@/scripts/header';
  import '@/scripts/mobile-menu';
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    --surface: rgba(251, 251, 249, 0.94);
    --text: var(--ink);
    --border: var(--line);
    --focus-color: var(--accent-deep);
    background: var(--surface);
    color: var(--text);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition:
      background 0.4s var(--ease),
      color 0.4s,
      border-color 0.4s;
  }

  .site-header[data-variant='overlay'] {
    position: fixed;
    inset: 0 0 auto 0;
  }

  .site-header[data-variant='overlay']:not([data-scrolled]):not([data-mega-open]) {
    --surface: transparent;
    --text: var(--paper);
    --border: transparent;
    --focus-color: var(--accent);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    height: var(--header-h);
  }

  .menu-toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    margin-right: -10px;
  }

  .menu-toggle__bar {
    position: absolute;
    left: 11px;
    right: 11px;
    height: 1.5px;
    background: currentColor;
  }

  .menu-toggle__bar:nth-of-type(2) {
    top: 17px;
  }

  .menu-toggle__bar:nth-of-type(3) {
    top: 25px;
  }

  @media (max-width: 1100px) {
    .menu-toggle {
      display: block;
    }
  }
</style>
