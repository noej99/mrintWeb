---
/**
 * MobileMenu — native <dialog> modal
 * showModal()이 focus trap, 배경 inert, ESC 닫기를 제공한다.
 * 동작: src/scripts/mobile-menu.ts
 */
import { toMailtoHref, toTelHref } from '@/lib/contact';
import { getCompany } from '@/lib/content';
import { NAVIGATION } from '@/data/navigation';
import { matchPath, withBase } from '@/lib/url';
import Logo from './Logo.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const company = await getCompany();
const ariaCurrent = (href: string) => {
  const match = matchPath(currentPath, href);
  return match === 'exact' ? 'page' : match ? 'true' : undefined;
};
---

<dialog id="mobile-menu" class="mobile-menu tone-ink" aria-labelledby="mobile-menu-title" data-mobile-menu>
  <div class="mobile-menu__bar">
    <Logo showName={false} />
    <button type="button" class="mobile-menu__close" data-mobile-menu-close autofocus>
      <span class="visually-hidden">전체 메뉴 닫기</span>
      <span class="mobile-menu__close-icon" aria-hidden="true"></span>
    </button>
  </div>

  <h2 id="mobile-menu-title" class="visually-hidden">전체 메뉴</h2>

  <nav class="mobile-menu__nav" aria-label="주 메뉴">
    {
      NAVIGATION.map((item) =>
        item.type === 'group' ? (
          <section class="mobile-menu__group" aria-labelledby={`mobile-menu-${item.id}`}>
            <h3 id={`mobile-menu-${item.id}`} class="mobile-menu__group-label eyebrow">
              {item.label}
            </h3>
            <ul class="mobile-menu__list" role="list">
              {item.children.map((link) => (
                <li>
                  <a class="mobile-menu__link" href={withBase(link.href)} aria-current={ariaCurrent(link.href)}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ) : (
          <a class="mobile-menu__link mobile-menu__link--solo" href={withBase(item.href)} aria-current={ariaCurrent(item.href)}>
            {item.label}
          </a>
        ),
      )
    }
  </nav>

  {
    company && (
      <div class="mobile-menu__foot">
        <a href={toTelHref(company.data.tel)}>T. {company.data.tel}</a>
        <a href={toMailtoHref(company.data.email)}>{company.data.email}</a>
      </div>
    )
  }
</dialog>

<style>
  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0 var(--pad) 40px;
    border: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mobile-menu[open] {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .mobile-menu::backdrop {
    background: var(--ink);
  }

  :global(html:has(.mobile-menu[open])) {
    overflow: hidden;
  }

  .mobile-menu__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    flex: none;
  }

  .mobile-menu__close {
    position: relative;
    width: 44px;
    height: 44px;
    margin-right: -10px;
  }

  .mobile-menu__close-icon::before,
  .mobile-menu__close-icon::after {
    content: '';
    position: absolute;
    left: 11px;
    right: 11px;
    top: 21px;
    height: 1.5px;
    background: currentColor;
  }

  .mobile-menu__close-icon::before {
    transform: rotate(45deg);
  }

  .mobile-menu__close-icon::after {
    transform: rotate(-45deg);
  }

  .mobile-menu__nav {
    display: grid;
    gap: 40px;
  }

  .mobile-menu__group-label {
    margin-bottom: 12px;
  }

  .mobile-menu__list {
    border-bottom: 1px solid var(--border);
  }

  .mobile-menu__list li {
    border-top: 1px solid var(--border);
  }

  .mobile-menu__link {
    display: flex;
    align-items: center;
    min-height: 64px;
    padding-block: 12px;
    font-size: clamp(24px, 6vw, 32px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.3;
  }

  .mobile-menu__link:focus-visible {
    outline-offset: -3px;
  }

  .mobile-menu__link[aria-current] {
    color: var(--accent-text);
  }

  .mobile-menu__link--solo {
    border-block: 1px solid var(--border);
  }

  .mobile-menu__foot {
    display: grid;
    gap: 4px;
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .mobile-menu__foot a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
